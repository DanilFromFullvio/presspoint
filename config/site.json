        },
        {
          "type": "search",
          "q": "premiér OR prezident OR minister Slovensko when:2d"
        },
        {
          "type": "rss",
          "url": "https://domov.sme.sk/rss",
          "name": "SME Domov"
        },
        {
          "type": "rss",
          "url": "https://www.teraz.sk/rss/slovensko.rss",
          "name": "TERAZ.sk"
        },
        {
          "type": "rss",
          "url": "https://hnonline.sk/rss",
          "name": "HNonline",
          "categoryFilter": "^Slovensko$"
        },
        {
          "type": "rss",
          "url": "https://spravy.pravda.sk/rss/xml/",
          "name": "Pravda",
          "categoryFilter": "^Domáce$"
        },
        {
          "type": "rss",
          "url": "https://dennikn.sk/feed/",
          "name": "Denník N",
          "categoryFilter": "^(Slovensko|Politika)$"
        }
      ]
    },
    {
      "slug": "ryba",
      "name": "Ryba",
      "color": "#2471a3",
      "description": "Rybárstvo, rybolov, rybári, vody a všetko okolo rýb.",
      "feeds": [
        {
          "type": "search",
          "q": "rybári OR rybolov OR rybárstvo when:14d"
        },
        {
          "type": "search",
          "q": "ryby OR rybník OR \"Slovenský rybársky zväz\" when:14d"
        },
        {
          "type": "search",
          "q": "kapor OR pstruh OR sumec OR šťuka OR zubáč when:14d"
        },
        {
          "type": "search",
          "q": "akvakultúra OR \"chov rýb\" OR rybárske preteky when:30d"
        },
        {
          "type": "search",
          "q": "site:srzrada.sk when:30d"
        }
